pipeline {
    agent {
        label 'ci-java21-node24'
    }

    options {
        skipDefaultCheckout()
        disableConcurrentBuilds()
        timeout(time: 10, unit: 'MINUTES')
    }

    parameters {
        string(
            name: 'RELEASE_BUILD_NUMBER',
            defaultValue: '',
            description: 'Exact successful build number from Bank-Demo-Release/image-build-pilot.'
        )
    }

    stages {
        stage('Validate selected release build') {
            steps {
                script {
                    def selectedBuild = params.RELEASE_BUILD_NUMBER?.trim()
                    if (!(selectedBuild ==~ /^[1-9][0-9]*$/)) {
                        error('RELEASE_BUILD_NUMBER must be a positive Jenkins build number.')
                    }
                    env.SELECTED_RELEASE_BUILD = selectedBuild
                }
            }
        }

        stage('Checkout trusted deployment contract') {
            steps {
                deleteDir()
                checkout scm

                sh '''
                    set -eu

                    git rev-parse HEAD
                    test -f ci/release-services.txt
                    test -f ci/validate-release-catalog.sh
                    test -f ci/prepare-release-env.sh
                    sh ci/validate-release-catalog.sh ci/release-services.txt
                '''
            }
        }

        stage('Copy manifest from the selected release build') {
            steps {
                copyArtifacts(
                    projectName: 'image-build-pilot',
                    selector: specific(env.SELECTED_RELEASE_BUILD),
                    filter: 'release-manifest.tsv',
                    target: 'release-input',
                    flatten: true,
                    fingerprintArtifacts: true,
                    optional: false
                )

                sh '''
                    set -eu
                    test -s release-input/release-manifest.tsv
                    printf 'Copied the manifest from release build #%s.\n' "$SELECTED_RELEASE_BUILD"
                    sha256sum release-input/release-manifest.tsv
                '''
            }
        }

        stage('Validate manifest and generate digest-pinned image inputs') {
            steps {
                sh '''
                    set -eu

                    generated_env="$WORKSPACE/release-input/images.env"
                    sh ci/prepare-release-env.sh \
                        "$WORKSPACE/release-input/release-manifest.tsv" \
                        > "$generated_env"

                    expected_count="$(sh ci/validate-release-catalog.sh ci/release-services.txt)"
                    actual_count="$(wc -l < "$generated_env" | tr -d '[:space:]')"
                    test "$actual_count" -eq "$expected_count"

                    printf 'Preflight validated %s pinned application image references. Values were not printed.\n' \
                        "$actual_count"
                '''
            }
        }

        stage('Archive validated release inputs') {
            steps {
                archiveArtifacts(
                    artifacts: 'release-input/release-manifest.tsv,release-input/images.env',
                    fingerprint: true,
                    onlyIfSuccessful: true
                )
            }
        }
    }

    post {
        always {
            sh 'rm -rf -- release-input'
        }
    }
}
