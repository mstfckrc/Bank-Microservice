# Bank-Microservice Docker Compose şablonu.
# Yerel ortam için .env olarak kopyalayıp makineye özel değerleri girin.
# Gerçek credential'lar yalnız Git dışındaki .env dosyasında kalmalı.

# Tarayıcıya açık URL'ler ve OIDC tokenlarının genel issuer adresi.
# NEXT_PUBLIC_* değerleri frontend çıktısına girer; buraya secret koymayın.
NEXT_PUBLIC_FRONTEND_URL=https://app.bank.local
# Public browser build settings; never put secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_API_URL=https://api.bank.local/api/v1
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.bank.local
# Yalnız origin yazın: şema + host + isteğe bağlı port; path veya wildcard yok.
GATEWAY_CORS_ALLOWED_ORIGINS=https://app.bank.local,https://docs.bank.local
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_google_recaptcha_site_key_here
# Frontend sunucu ayarları; web client secret'ını frontend sunucusu kullanır.
FRONTEND_KEYCLOAK_REALM=bank-realm
FRONTEND_KEYCLOAK_CLIENT_ID=bank-auth-client
EUREKA_URL=http://discovery-server:8761/eureka/
ES_URL=http://elasticsearch:9200
KC_INTERNAL_URL=http://keycloak:8080

RMQ_HOST=rabbitmq
RMQ_PORT=5672

REDIS_HOST=redis
REDIS_PORT=6379

# Compose ağı içindeki servis adresleri.
# KC_INTERNAL_URL container'ların Keycloak'a erişimi içindir; OAUTH_ISSUER_URI tokenın genel issuer adresidir.

# Servis başına veritabanı bağlantı ayarları.
# Core
CORE_DB_URL=jdbc:postgresql://postgres-core:5432/bank_core_db
CORE_DB_USER=postgres
CORE_DB_PASS=your_core_db_password_here

# Auth
AUTH_DB_URL=jdbc:postgresql://postgres-auth:5432/bank_auth_db
AUTH_DB_USER=postgres
AUTH_DB_PASS=your_auth_db_password_here

# Bill
BILL_DB_URL=jdbc:postgresql://postgres-bill:5432/bank_bill_db
BILL_DB_USER=postgres
BILL_DB_PASS=your_bill_db_password_here

# Corporate
CORP_DB_URL=jdbc:postgresql://postgres-corporate:5432/bank_corporate_db
CORP_DB_USER=postgres
CORP_DB_PASS=your_corporate_db_password_here

# Keycloak sunucusunun veritabanı bağlantısı; uygulama kullanıcı girişi değildir.
KC_DB_URL=jdbc:postgresql://keycloak-db:5432/keycloak
KC_DB_USER=keycloak
KC_DB_PASS=your_keycloak_db_password_here

# Keycloak yönetim konsolunun yerel yönetici hesabı.
KC_ADMIN_USER=admin
KC_ADMIN_PASS=your_keycloak_admin_password_here

# Gizli web-login client secret'ı; yalnız frontend sunucusu kullanır.
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret_here
# bank-auth-admin: Auth servisinin Keycloak kullanıcı/uygulama rolü yönetim hesabı.
# Bu secret'ı web-login veya Corporate servis client secret'ıyla paylaşmayın.
KEYCLOAK_ADMIN_CLIENT_SECRET=your_bank_auth_admin_client_secret_here
# bank-corporate-service: Corporate'ın sınırlı Auth profil sorgusu için client secret'ı.
# Compose bu değeri Corporate container'ında BANK_SERVICE_CLIENT_SECRET adına eşler.
CORPORATE_BANK_SERVICE_CLIENT_SECRET=your_bank_corporate_service_client_secret_here
# bank-auth-service: Auth'un Core müşteri hesap kapatma izni için ayrı client secret.
AUTH_BANK_SERVICE_CLIENT_SECRET=your_bank_auth_service_client_secret_here
# bank-bill-service: Bill'in Core fatura tahsilatı izni için ayrı client secret.
BILL_BANK_SERVICE_CLIENT_SECRET=your_bank_bill_service_client_secret_here
OAUTH_ISSUER_URI=https://auth.bank.local/realms/bank-realm

# RabbitMQ bağlantı ayarları.
RMQ_USER=admin
RMQ_PASS=your_rabbitmq_password_here

# Auth servisinin mevcut JWT entegrasyonu için kullandığı secret.
JWT_SECRET=your_256_bit_jwt_secret_hex_here

# Auth sunucusunun reCAPTCHA secret'ı; eşleşen site key frontend'de herkese açıktır.
RECAPTCHA_SECRET=your_google_recaptcha_secret_key_here

# Yerel Grafana giriş bilgileri.
GRAFANA_USER=admin
GRAFANA_PASS=your_grafana_password_here
