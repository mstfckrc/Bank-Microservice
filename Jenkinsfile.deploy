pipeline {
    agent {
        label 'release-image-builder'
    }

    options {
        skipDefaultCheckout()
        disableConcurrentBuilds()
        timeout(time: 180, unit: 'MINUTES')
    }

    parameters {
        choice(
            name: 'ACTION',
            choices: ['status', 'validate', 'deploy', 'rollback'],
            description: 'status is read-only; validate checks a release; deploy applies a selected release and automatically rolls back on failed health checks; rollback restores the previous images for the selected deployment.'
        )
        string(
            name: 'RELEASE_BUILD_NUMBER',
            defaultValue: '',
            description: 'Exact successful Bank-Demo-Release/image-build-pilot build number for validate/deploy.'
        )
        string(
            name: 'DEPLOYMENT_ID',
            defaultValue: '',
            description: 'Deployment ID returned by deploy-bank; required only for rollback.'
        )
    }

    stages {
        stage('Validate request parameters') {
            steps {
                script {
                    if (!(params.ACTION in ['validate', 'status', 'deploy', 'rollback'])) {
                        error('Unsupported ACTION.')
                    }

                    if (params.ACTION in ['validate', 'deploy']) {
                        def selectedBuild = params.RELEASE_BUILD_NUMBER?.trim()
                        if (!(selectedBuild ==~ /^[1-9][0-9]{0,8}$/)) {
                            error('RELEASE_BUILD_NUMBER must be a positive image-build-pilot build number.')
                        }
                        env.SELECTED_RELEASE_BUILD = selectedBuild
                    } else {
                        env.SELECTED_RELEASE_BUILD = ''
                    }

                    if (params.ACTION == 'rollback') {
                        def deploymentId = params.DEPLOYMENT_ID?.trim()
                        if (!(deploymentId ==~ /^deploy-[0-9a-f]{32}$/)) {
                            error('DEPLOYMENT_ID must be a deployment ID previously returned by deploy-bank.')
                        }
                        env.SELECTED_DEPLOYMENT_ID = deploymentId
                    } else {
                        env.SELECTED_DEPLOYMENT_ID = ''
                    }
                }
            }
        }

        stage('Confirm selected release succeeded') {
            when {
                expression { params.ACTION in ['validate', 'deploy'] }
            }
            steps {
                script {
                    def sourceRun = waitForBuild(
                        runId: "Bank-Demo-Release/image-build-pilot#${env.SELECTED_RELEASE_BUILD}",
                        propagate: false,
                        propagateAbort: false
                    )
                    if (sourceRun.result != 'SUCCESS') {
                        error("Selected image release did not finish SUCCESS (result: ${sourceRun.result}).")
                    }
                    env.SELECTED_RELEASE_RUN_ID = sourceRun.externalizableId
                    echo "Selected successful image release ${sourceRun.externalizableId}."
                }
            }
        }

        stage('Checkout trusted deploy contract') {
            steps {
                deleteDir()
                checkout scm
                sh '''
                    set -eu
                    git rev-parse HEAD
                    test -f ci/release-services.txt
                    test -f ci/validate-release-catalog.sh
                    test -f ci/prepare-release-env.sh
                    test -f ci/deploy/protocol.py
                    test -f ci/deploy/bootstrap_host_validation.py
                    test -f ci/deploy/deployment.py
                    test -f ci/deploy/tests/test_protocol.py
                    sh ci/validate-release-catalog.sh ci/release-services.txt
                '''
            }
        }

        stage('Test deploy request contract') {
            steps {
                sh 'python3 -m unittest discover -s ci/deploy/tests -v'
            }
        }

        stage('Copy and validate exact release manifest') {
            when {
                expression { params.ACTION in ['validate', 'deploy'] }
            }
            steps {
                copyArtifacts(
                    projectName: 'image-build-pilot',
                    selector: specific(env.SELECTED_RELEASE_BUILD),
                    filter: 'release-manifest.tsv',
                    target: 'deploy-input',
                    flatten: true,
                    fingerprintArtifacts: true,
                    optional: false
                )
                sh '''
                    set -eu
                    test -s deploy-input/release-manifest.tsv
                    sh ci/prepare-release-env.sh \
                        deploy-input/release-manifest.tsv \
                        > deploy-input/images.env
                    expected_count="$(sh ci/validate-release-catalog.sh ci/release-services.txt)"
                    actual_count="$(wc -l < deploy-input/images.env | tr -d '[:space:]')"
                    test "$actual_count" -eq "$expected_count"
                    printf 'Validated the complete %s-service release manifest. Values were not printed.\n' \
                        "$actual_count"
                    sha256sum deploy-input/release-manifest.tsv
                '''
            }
        }

        stage('Create bounded helper request') {
            steps {
                sh 'mkdir -p deploy-input'
                script {
                    def requestId = sh(
                        script: '''
                            set -eu
                            if [ "$ACTION" = status ]; then
                                python3 ci/deploy/protocol.py create-request \
                                    --action "$ACTION" \
                                    --output deploy-input/request.json
                            elif [ "$ACTION" = rollback ]; then
                                python3 ci/deploy/protocol.py create-request \
                                    --action "$ACTION" \
                                    --deployment-id "$SELECTED_DEPLOYMENT_ID" \
                                    --output deploy-input/request.json
                            else
                                python3 ci/deploy/protocol.py create-request \
                                    --action "$ACTION" \
                                    --release-build-number "$SELECTED_RELEASE_BUILD" \
                                    --manifest deploy-input/release-manifest.tsv \
                                    --output deploy-input/request.json
                            fi
                            python3 -c 'import json; print(json.load(open("deploy-input/request.json"))["request_id"])'
                        ''',
                        returnStdout: true
                    ).trim().readLines().last()
                    env.DEPLOY_REQUEST_ID = requestId
                    env.DEPLOY_MANIFEST_SHA256 = params.ACTION in ['validate', 'deploy']
                        ? sh(
                            script: 'sha256sum deploy-input/release-manifest.tsv | cut -d " " -f 1',
                            returnStdout: true
                        ).trim()
                        : ''
                }
            }
        }

        stage('Submit request to restricted Bank helper') {
            steps {
                withCredentials([sshUserPrivateKey(
                    credentialsId: 'bank-demo-bank-deploy-ssh',
                    keyFileVariable: 'BANK_DEPLOY_KEY',
                    usernameVariable: 'BANK_DEPLOY_USER'
                )]) {
                    sh '''
                        set -eu
                        set +x
                        test "$BANK_DEPLOY_USER" = 'bank-deploy'
                        ssh \
                            -i "$BANK_DEPLOY_KEY" \
                            -o ConnectTimeout=15 \
                            -o ServerAliveInterval=10 \
                            -o ServerAliveCountMax=3 \
                            -o IdentitiesOnly=yes \
                            -o BatchMode=yes \
                            -o RequestTTY=no \
                            -o StrictHostKeyChecking=yes \
                            -o UserKnownHostsFile=/etc/jenkins/known_hosts/bank \
                            bank-deploy@192.168.56.10 \
                            < deploy-input/request.json \
                            > deploy-input/response.json
                        if [ "$ACTION" = validate ] || [ "$ACTION" = deploy ]; then
                            python3 ci/deploy/protocol.py check-response \
                                --action "$ACTION" \
                                --request-id "$DEPLOY_REQUEST_ID" \
                                --release-build-number "$SELECTED_RELEASE_BUILD" \
                                --manifest-sha256 "$DEPLOY_MANIFEST_SHA256" \
                                --input deploy-input/response.json
                        elif [ "$ACTION" = rollback ]; then
                            python3 ci/deploy/protocol.py check-response \
                                --action "$ACTION" \
                                --request-id "$DEPLOY_REQUEST_ID" \
                                --deployment-id "$SELECTED_DEPLOYMENT_ID" \
                                --input deploy-input/response.json
                        else
                            python3 ci/deploy/protocol.py check-response \
                                --action "$ACTION" \
                                --request-id "$DEPLOY_REQUEST_ID" \
                                --input deploy-input/response.json
                        fi
                    '''
                }
            }
        }

    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'deploy-input/response.json',
                fingerprint: true,
                allowEmptyArchive: true,
                onlyIfSuccessful: false
            )
            sh 'rm -rf -- deploy-input'
        }
    }
}
