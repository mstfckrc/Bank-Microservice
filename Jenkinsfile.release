pipeline {
    agent {
        label 'release-image-builder'
    }

    parameters {
        string(
            name: 'CI_RUN_ID',
            defaultValue: '',
            description: 'Internal: successful bankdemo-ci-build-pilot run number. Used for automatic publication and authorized retries.'
        )
    }

    options {
        skipDefaultCheckout()
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
    }

    stages {
        stage('Verify successful main CI provenance') {
            steps {
                script {
                    if (!(params.CI_RUN_ID ==~ /^[1-9][0-9]*$/)) {
                        error('CI_RUN_ID must identify a successful main CI build.')
                    }

                    def causes = currentBuild.getBuildCauses()
                    def upstreamCause = causes.find { cause ->
                        cause.upstreamProject == 'bankdemo-ci-build-pilot' &&
                            cause.upstreamBuild?.toString() == params.CI_RUN_ID
                    }
                    def authorizedManualRetry = causes.any { cause ->
                        cause._class == 'hudson.model.Cause$UserIdCause'
                    }
                    def hasUpstreamCause = causes.any { cause -> cause.upstreamProject != null }
                    if ((hasUpstreamCause && upstreamCause == null) ||
                        (!hasUpstreamCause && !authorizedManualRetry)) {
                        error('This publisher must be triggered by the matching main CI run or by an authorized manual retry.')
                    }

                    copyArtifacts(
                        projectName: 'bankdemo-ci-build-pilot',
                        selector: specific(params.CI_RUN_ID),
                        filter: 'source-provenance.txt',
                        fingerprintArtifacts: true
                    )

                    def sourceCommit = readFile('source-provenance.txt').trim()
                    if (!(sourceCommit ==~ /^[0-9a-f]{40}$/)) {
                        error('The upstream CI provenance artifact does not contain a valid full source SHA.')
                    }
                    env.VERIFIED_SOURCE_SHA = sourceCommit
                    echo "Verified successful main CI run #${params.CI_RUN_ID} for source ${sourceCommit}."
                }
            }
        }

        stage('Checkout the exact CI-verified source') {
            steps {
                checkout scm
                sh '''
                    set -eu
                    git fetch --no-tags origin main
                    git cat-file -e "${VERIFIED_SOURCE_SHA}^{commit}"
                    git checkout --detach "$VERIFIED_SOURCE_SHA"
                    test "$(git rev-parse HEAD)" = "$VERIFIED_SOURCE_SHA"
                    printf 'Publisher checkout is pinned to CI-verified source %s.\n' "$VERIFIED_SOURCE_SHA"
                '''
                sh '''
                    set -eu
                    for path in \
                        ci/release-public.sh \
                        ci/release-services.txt \
                        ci/validate-release-catalog.sh \
                        ci/selective_release.py \
                        ci/tests/test_selective_release.py; do
                        test -f "$path" || {
                            printf 'Required release input is missing: %s\n' "$path" >&2
                            exit 1
                        }
                    done

                    sh ci/validate-release-catalog.sh ci/release-services.txt

                    sed '1d' ci/release-services.txt | while IFS='|' read -r service context_dir repository target; do
                        case "$service" in ''|'#'*) continue ;; esac
                        test -d "$context_dir"
                        test -f "$context_dir/Dockerfile"

                        if [ "$service" = 'frontend' ]; then
                            test -f "$context_dir/package.json"
                            test -f "$context_dir/package-lock.json"
                        fi
                    done
                '''
            }
        }

        stage('Test selective publication rules') {
            steps {
                sh '''
                    set -eu
                    /usr/bin/python3 --version
                    PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 -m unittest discover \
                        -s ci/tests -p 'test_selective_release.py' -v
                '''
            }
        }

        stage('Verify rootless image builder and public settings') {
            steps {
                sh '''
                    set -eu
                    test "$(id -un)" = "jenkins-release"
                    buildctl --version
                    buildctl debug workers
                '''
                sh '''
                    set -eu
                    set -a
                    . "$WORKSPACE/ci/release-public.sh"
                    set +a

                    test -n "${NEXT_PUBLIC_FRONTEND_URL:-}"
                    test -n "${NEXT_PUBLIC_API_URL:-}"
                    test -n "${NEXT_PUBLIC_KEYCLOAK_URL:-}"
                    test -n "${NEXT_PUBLIC_RECAPTCHA_SITE_KEY:-}"

                    case "$NEXT_PUBLIC_FRONTEND_URL" in https://*) ;; *) echo 'Frontend URL must use HTTPS.' >&2; exit 1 ;; esac
                    case "$NEXT_PUBLIC_API_URL" in https://*) ;; *) echo 'API URL must use HTTPS.' >&2; exit 1 ;; esac
                    case "$NEXT_PUBLIC_KEYCLOAK_URL" in https://*) ;; *) echo 'Keycloak URL must use HTTPS.' >&2; exit 1 ;; esac
                    case "$NEXT_PUBLIC_RECAPTCHA_SITE_KEY" in your_*|change-me*|placeholder*) echo 'Replace the frontend reCAPTCHA placeholder before publishing.' >&2; exit 1 ;; esac

                    echo 'Required public frontend build settings are present; values are not printed.'
                '''
            }
        }

        stage('Compare with the last successful publication') {
            steps {
                sh '''
                    set -eu
                    rm -rf -- previous-release release-plan release-manifest.tsv published-source.sha release-summary.tsv
                    mkdir -p previous-release release-plan
                '''
                copyArtifacts(
                    projectName: 'Bank-Demo-Release/image-build-pilot',
                    selector: lastSuccessful(),
                    filter: 'published-source.sha,release-manifest.tsv',
                    target: 'previous-release',
                    optional: true,
                    fingerprintArtifacts: true
                )
                script {
                    def baselineFile = 'previous-release/published-source.sha'
                    if (!fileExists(baselineFile)) {
                        env.RELEASE_BASELINE_SHA = ''
                        echo 'No successful-publication baseline exists; the selector will choose the full catalog.'
                    } else {
                        def baseline = readFile(baselineFile).trim()
                        if (!(baseline ==~ /^[0-9a-f]{40}$/)) {
                            error('The last successful publication has an invalid source SHA baseline.')
                        }
                        if (!fileExists('previous-release/release-manifest.tsv')) {
                            error('The last successful publication is missing its canonical image manifest.')
                        }
                        def sourceIsOlder = sh(
                            script: 'git merge-base --is-ancestor "$VERIFIED_SOURCE_SHA" "' + baseline + '"',
                            returnStatus: true
                        )
                        if (sourceIsOlder == 0 && baseline != env.VERIFIED_SOURCE_SHA) {
                            error('This CI run predates the last successful publication; refusing to move the publication baseline backwards.')
                        }
                        if (sourceIsOlder != 0) {
                            def baselineIsAncestor = sh(
                                script: 'git merge-base --is-ancestor "' + baseline + '" "$VERIFIED_SOURCE_SHA"',
                                returnStatus: true
                            )
                            if (baselineIsAncestor != 0) {
                                error('The CI-verified source and last publication are not on the same main history.')
                            }
                        }
                        env.RELEASE_BASELINE_SHA = baseline
                    }
                }
                sh '''
                    set -eu
                    /usr/bin/python3 ci/selective_release.py plan \
                        --repo-root "$WORKSPACE" \
                        --source-sha "$VERIFIED_SOURCE_SHA" \
                        --baseline-sha "${RELEASE_BASELINE_SHA:-}" \
                        --current-catalog ci/release-services.txt \
                        --previous-manifest previous-release/release-manifest.tsv \
                        --output-dir release-plan
                '''
                script {
                    def selectedCount = sh(
                        script: "awk 'NR > 1 && NF { count++ } END { print count + 0 }' release-plan/build-catalog.txt",
                        returnStdout: true
                    ).trim().toInteger()
                    env.PUBLISH_IMAGES = selectedCount > 0 ? 'true' : 'false'
                    if (selectedCount > 0) {
                        echo "${selectedCount} image(s) selected; the remaining catalog entries will reuse prior successful digests."
                    } else {
                        echo 'No image inputs changed; no image build or registry push will run.'
                    }
                }
            }
        }

        stage('Build and push selected application images') {
            when {
                expression { env.PUBLISH_IMAGES == 'true' }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-bank-demo-push',
                    usernameVariable: 'DOCKERHUB_USERNAME',
                    passwordVariable: 'DOCKERHUB_TOKEN'
                )]) {
                    sh '''
                        set +x
                        set -eu

                        release_root="$(mktemp -d "${WORKSPACE:?}/bank-demo-release.XXXXXX")"
                        trap 'rm -rf "$release_root"' EXIT

                        export DOCKER_CONFIG="$release_root/docker-config"
                        mkdir -m 700 "$DOCKER_CONFIG"

                        auth="$(printf '%s:%s' "$DOCKERHUB_USERNAME" "$DOCKERHUB_TOKEN" | base64 | tr -d '\n')"
                        printf '{"auths":{"https://index.docker.io/v1/":{"auth":"%s"}}}\n' \
                            "$auth" > "$DOCKER_CONFIG/config.json"
                        chmod 600 "$DOCKER_CONFIG/config.json"
                        unset auth DOCKERHUB_TOKEN

                        set -a
                        . "$WORKSPACE/ci/release-public.sh"
                        set +a

                        source_commit="$VERIFIED_SOURCE_SHA"
                        manifest_file="$WORKSPACE/release-plan/build-manifest.tsv"
                        catalog_file="$WORKSPACE/release-plan/build-catalog.txt"
                        expected_count="$(sh "$WORKSPACE/ci/validate-release-catalog.sh" "$catalog_file")"
                        printf 'Building and publishing %s selected image(s) from source commit %s\n' "$expected_count" "$source_commit"
                        image_list="$release_root/images.list"
                        sed '1d' "$catalog_file" > "$image_list"

                        index=0
                        while IFS='|' read -r service context_dir repository target; do
                            case "$service" in ''|'#'*) continue ;; esac
                            index=$((index + 1))
                            image_ref="docker.io/mstfckrc/${repository}:sha-${source_commit}"
                            metadata_file="$release_root/${service}-metadata.json"

                            printf '\n=== [%s/%s] %s -> %s ===\n' "$index" "$expected_count" "$service" "$image_ref"

                            if [ "$service" = 'frontend' ]; then
                                buildctl build \
                                    --frontend dockerfile.v0 \
                                    --local context="$WORKSPACE/$context_dir" \
                                    --local dockerfile="$WORKSPACE/$context_dir" \
                                    --opt filename=Dockerfile \
                                    --opt "target=$target" \
                                    --opt "build-arg:NEXT_PUBLIC_FRONTEND_URL=$NEXT_PUBLIC_FRONTEND_URL" \
                                    --opt "build-arg:NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL" \
                                    --opt "build-arg:NEXT_PUBLIC_KEYCLOAK_URL=$NEXT_PUBLIC_KEYCLOAK_URL" \
                                    --opt "build-arg:NEXT_PUBLIC_RECAPTCHA_SITE_KEY=$NEXT_PUBLIC_RECAPTCHA_SITE_KEY" \
                                    --metadata-file "$metadata_file" \
                                    --output "type=image,name=$image_ref,push=true"
                            else
                                buildctl build \
                                    --frontend dockerfile.v0 \
                                    --local context="$WORKSPACE/$context_dir" \
                                    --local dockerfile="$WORKSPACE/$context_dir" \
                                    --opt filename=Dockerfile \
                                    --opt "target=$target" \
                                    --metadata-file "$metadata_file" \
                                    --output "type=image,name=$image_ref,push=true"
                            fi

                            test -s "$metadata_file"
                            image_digest="$(awk -F '"' '$2 == "containerimage.digest" { print $4 }' "$metadata_file")"
                            printf '%s\n' "$image_digest" | grep -Eq '^sha256:[0-9a-f]{64}$'
                            printf '%s\t%s\t%s\n' "$service" "$image_ref" "$image_digest" >> "$manifest_file"
                            printf 'Published digest: %s\n' "$image_digest"
                        done < "$image_list"

                        test "$index" -eq "$expected_count"
                        printf '\nPublished all %s selected application image(s) successfully.\n' "$index"
                    '''
                }
            }
        }

        stage('Assemble and validate complete release manifest') {
            steps {
                sh '''
                    set -eu
                    /usr/bin/python3 ci/selective_release.py complete \
                        --source-sha "$VERIFIED_SOURCE_SHA" \
                        --current-catalog ci/release-services.txt \
                        --build-catalog release-plan/build-catalog.txt \
                        --plan-json release-plan/plan.json \
                        --reuse-manifest release-plan/reuse-manifest.tsv \
                        --built-manifest release-plan/build-manifest.tsv \
                        --output-manifest release-manifest.tsv \
                        --output-source-sha published-source.sha \
                        --output-summary release-summary.tsv
                '''
            }
        }
    }

    post {
        always {
            script {
                if (currentBuild.currentResult == 'SUCCESS') {
                    archiveArtifacts artifacts: 'release-manifest.tsv,published-source.sha,release-summary.tsv,release-plan/plan.json', fingerprint: true
                }
            }
            sh 'rm -rf -- previous-release release-plan release-manifest.tsv published-source.sha release-summary.tsv source-provenance.txt'
        }
    }
}
