pipeline {
    agent {
        label 'release-image-builder'
    }

    options {
        skipDefaultCheckout()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {
        stage('Checkout trusted source') {
            steps {
                checkout scm

                sh '''
                    set -eu

                    git rev-parse HEAD
                    test -f discovery-server/Dockerfile
                    test -f discovery-server/pom.xml
                '''
            }
        }

        stage('Release agent and BuildKit verification') {
            steps {
                sh '''
                    set -eu

                    test "$(id -un)" = "jenkins-release"
                    buildctl --version
                    buildctl debug workers
                '''
            }
        }

        stage('Build a disposable OCI smoke image') {
            steps {
                sh '''
                    set -eu

                    smoke_root="$(mktemp -d "${WORKSPACE:?}/buildkit-smoke.XXXXXX")"
                    trap 'rm -rf "$smoke_root"' EXIT

                    mkdir -p "$smoke_root/context" "$smoke_root/output"
                    printf 'Bank-Demo BuildKit smoke test\\n' > "$smoke_root/context/message.txt"
                    printf '%s\\n' \\
                        'FROM scratch' \\
                        'COPY message.txt /message.txt' \\
                        > "$smoke_root/context/Dockerfile"

                    buildctl build \\
                        --frontend dockerfile.v0 \\
                        --local context="$smoke_root/context" \\
                        --local dockerfile="$smoke_root/context" \\
                        --output "type=oci,dest=$smoke_root/output/smoke-image.tar"

                    test -s "$smoke_root/output/smoke-image.tar"
                    du -h "$smoke_root/output/smoke-image.tar"
                '''
            }
        }

        stage('Build and push discovery-server image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-bank-demo-push',
                    usernameVariable: 'DOCKERHUB_USERNAME',
                    passwordVariable: 'DOCKERHUB_TOKEN'
                )]) {
                    sh '''
                        set +x
                        set -eu

                        release_root="$(mktemp -d "${WORKSPACE:?}/discovery-server-release.XXXXXX")"
                        trap 'rm -rf "$release_root"' EXIT

                        export DOCKER_CONFIG="$release_root/docker-config"
                        mkdir -m 700 "$DOCKER_CONFIG"

                        auth="$(printf '%s:%s' "$DOCKERHUB_USERNAME" "$DOCKERHUB_TOKEN" | base64 | tr -d '\n')"
                        printf '{"auths":{"https://index.docker.io/v1/":{"auth":"%s"}}}\n' \\
                            "$auth" > "$DOCKER_CONFIG/config.json"
                        chmod 600 "$DOCKER_CONFIG/config.json"
                        unset auth

                        source_commit="$(git rev-parse HEAD)"
                        case "$source_commit" in
                            *[!0-9a-f]*|'')
                                echo 'Invalid source commit SHA.' >&2
                                exit 1
                                ;;
                        esac
                        test "${#source_commit}" -eq 40

                        image_ref="docker.io/mstfckrc/discovery-server:sha-${source_commit}"
                        metadata_file="$release_root/build-metadata.json"
                        printf 'Source commit: %s\nImage: %s\n' "$source_commit" "$image_ref"

                        buildctl build \\
                            --frontend dockerfile.v0 \\
                            --local context="$WORKSPACE/discovery-server" \\
                            --local dockerfile="$WORKSPACE/discovery-server" \\
                            --opt filename=Dockerfile \\
                            --opt target=runtime \\
                            --metadata-file "$metadata_file" \\
                            --output "type=image,name=$image_ref,push=true"

                        test -s "$metadata_file"
                        image_digest="$(awk -F '"' '$2 == "containerimage.digest" { print $4 }' "$metadata_file")"
                        test -n "$image_digest"
                        printf 'Published digest: %s\n' "$image_digest"
                    '''
                }
            }
        }
    }
}
