pipeline {
    agent {
        label 'release-image-builder'
    }

    options {
        skipDefaultCheckout()
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
    }

    stages {
        stage('Checkout trusted source') {
            steps {
                checkout scm

                sh '''
                    set -eu

                    git rev-parse HEAD

                    for path in \
                        Bank-Demo-Backend/Dockerfile \
                        Bank-Demo-Backend/pom.xml \
                        api-gateway/Dockerfile \
                        api-gateway/pom.xml \
                        bank-auth-micro/Dockerfile \
                        bank-auth-micro/pom.xml \
                        bank-corporate-micro/Dockerfile \
                        bank-corporate-micro/pom.xml \
                        bill-service/Dockerfile \
                        bill-service/pom.xml \
                        currency-service/Dockerfile \
                        currency-service/pom.xml \
                        discovery-server/Dockerfile \
                        discovery-server/pom.xml \
                        notification-service/Dockerfile \
                        notification-service/pom.xml \
                        Bank-Demo-Frontend/Dockerfile \
                        Bank-Demo-Frontend/package.json \
                        Bank-Demo-Frontend/package-lock.json \
                        ci/release-public.sh; do
                        test -f "$path" || {
                            printf 'Required release input is missing: %s\\n' "$path" >&2
                            exit 1
                        }
                    done
                '''
            }
        }

        stage('Release agent and BuildKit verification') {
            steps {
                sh '''
                    set -eu

                    test "$(id -un)" = "jenkins-release"
                    buildctl --version
                    buildctl debug workers
                '''
            }
        }

        stage('Validate public frontend build settings') {
            steps {
                sh '''
                    set -eu
                    set -a
                    . "$WORKSPACE/ci/release-public.sh"
                    set +a

                    test -n "${NEXT_PUBLIC_FRONTEND_URL:-}"
                    test -n "${NEXT_PUBLIC_API_URL:-}"
                    test -n "${NEXT_PUBLIC_KEYCLOAK_URL:-}"
                    test -n "${NEXT_PUBLIC_RECAPTCHA_SITE_KEY:-}"

                    case "$NEXT_PUBLIC_FRONTEND_URL" in https://*) ;; *) echo 'Frontend URL must use HTTPS.' >&2; exit 1 ;; esac
                    case "$NEXT_PUBLIC_API_URL" in https://*) ;; *) echo 'API URL must use HTTPS.' >&2; exit 1 ;; esac
                    case "$NEXT_PUBLIC_KEYCLOAK_URL" in https://*) ;; *) echo 'Keycloak URL must use HTTPS.' >&2; exit 1 ;; esac
                    case "$NEXT_PUBLIC_RECAPTCHA_SITE_KEY" in your_*|change-me*|placeholder*) echo 'Replace the frontend reCAPTCHA placeholder before publishing.' >&2; exit 1 ;; esac

                    echo 'All required public frontend build settings are present; values are not printed.'
                '''
            }
        }

        stage('Build and push all application images') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-bank-demo-push',
                    usernameVariable: 'DOCKERHUB_USERNAME',
                    passwordVariable: 'DOCKERHUB_TOKEN'
                )]) {
                    sh '''
                        set +x
                        set -eu

                        release_root="$(mktemp -d "${WORKSPACE:?}/bank-demo-release.XXXXXX")"
                        trap 'rm -rf "$release_root"' EXIT

                        export DOCKER_CONFIG="$release_root/docker-config"
                        mkdir -m 700 "$DOCKER_CONFIG"

                        auth="$(printf '%s:%s' "$DOCKERHUB_USERNAME" "$DOCKERHUB_TOKEN" | base64 | tr -d '\\n')"
                        printf '{"auths":{"https://index.docker.io/v1/":{"auth":"%s"}}}\\n' \\
                            "$auth" > "$DOCKER_CONFIG/config.json"
                        chmod 600 "$DOCKER_CONFIG/config.json"
                        unset auth DOCKERHUB_TOKEN

                        set -a
                        . "$WORKSPACE/ci/release-public.sh"
                        set +a

                        source_commit="$(git rev-parse HEAD)"
                        case "$source_commit" in
                            *[!0-9a-f]*|'')
                                echo 'Invalid source commit SHA.' >&2
                                exit 1
                                ;;
                        esac
                        test "${#source_commit}" -eq 40

                        manifest_file="$WORKSPACE/release-manifest.tsv"
                        printf 'service\\timage\\tdigest\\n' > "$manifest_file"
                        printf 'Building and publishing nine images from source commit %s\\n' "$source_commit"

                        image_list="$release_root/images.list"
                        printf '%s\\n' \\
                            'backend|Bank-Demo-Backend|backend|runtime' \\
                            'api-gateway|api-gateway|api-gateway|runtime' \\
                            'auth-service|bank-auth-micro|auth-service|runtime' \\
                            'corporate-service|bank-corporate-micro|corporate-service|runtime' \\
                            'bill-service|bill-service|bill-service|runtime' \\
                            'currency-service|currency-service|currency-service|runtime' \\
                            'discovery-server|discovery-server|discovery-server|runtime' \\
                            'notification-service|notification-service|notification-service|runtime' \\
                            'frontend|Bank-Demo-Frontend|frontend|runner' \\
                            > "$image_list"

                        index=0
                        while IFS='|' read -r service context_dir repository target; do
                            test -n "$service" || continue
                            index=$((index + 1))
                            image_ref="docker.io/mstfckrc/${repository}:sha-${source_commit}"
                            metadata_file="$release_root/${service}-metadata.json"

                            printf '\\n=== [%s/9] %s -> %s ===\\n' "$index" "$service" "$image_ref"

                            if [ "$service" = 'frontend' ]; then
                                buildctl build \\
                                    --frontend dockerfile.v0 \\
                                    --local context="$WORKSPACE/$context_dir" \\
                                    --local dockerfile="$WORKSPACE/$context_dir" \\
                                    --opt filename=Dockerfile \\
                                    --opt "target=$target" \\
                                    --opt "build-arg:NEXT_PUBLIC_FRONTEND_URL=$NEXT_PUBLIC_FRONTEND_URL" \\
                                    --opt "build-arg:NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL" \\
                                    --opt "build-arg:NEXT_PUBLIC_KEYCLOAK_URL=$NEXT_PUBLIC_KEYCLOAK_URL" \\
                                    --opt "build-arg:NEXT_PUBLIC_RECAPTCHA_SITE_KEY=$NEXT_PUBLIC_RECAPTCHA_SITE_KEY" \\
                                    --metadata-file "$metadata_file" \\
                                    --output "type=image,name=$image_ref,push=true"
                            else
                                buildctl build \\
                                    --frontend dockerfile.v0 \\
                                    --local context="$WORKSPACE/$context_dir" \\
                                    --local dockerfile="$WORKSPACE/$context_dir" \\
                                    --opt filename=Dockerfile \\
                                    --opt "target=$target" \\
                                    --metadata-file "$metadata_file" \\
                                    --output "type=image,name=$image_ref,push=true"
                            fi

                            test -s "$metadata_file"
                            image_digest="$(awk -F '"' '$2 == "containerimage.digest" { print $4 }' "$metadata_file")"
                            printf '%s\\n' "$image_digest" | grep -Eq '^sha256:[0-9a-f]{64}$'
                            printf '%s\\t%s\\t%s\\n' "$service" "$image_ref" "$image_digest" >> "$manifest_file"
                            printf 'Published digest: %s\\n' "$image_digest"
                        done < "$image_list"

                        test "$index" -eq 9
                        printf '\\nRelease image manifest for source commit %s:\\n' "$source_commit"
                        cat "$manifest_file"
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'release-manifest.tsv', allowEmptyArchive: true, fingerprint: true
            sh 'rm -f release-manifest.tsv'
        }
    }
}
